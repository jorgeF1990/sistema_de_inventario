# ============================================================
# SISTEMA DE CONTROL DE STOCK - TEMPLATE DE CONFIGURACION
# Copiar este archivo a .env y completar con valores reales
# ============================================================

# ============================================================
# BASE DE DATOS - PRODUCCION (RAILWAY)
# ============================================================
DB_HOST_PRODUCTION=
DB_PORT_PRODUCTION=23144
DB_USER_PRODUCTION=root
DB_PASSWORD_PRODUCTION=
DB_NAME_PRODUCTION=railway

# ============================================================
# BASE DE DATOS - LOCAL (DESARROLLO)
# ============================================================
DB_HOST_LOCAL=localhost
DB_PORT_LOCAL=3306
DB_USER_LOCAL=root
DB_PASSWORD_LOCAL=
DB_NAME_LOCAL=control_stock

# ============================================================
# BASE DE DATOS - SELECCION ACTIVA
# ============================================================
# Para produccion (Railway/Vercel):
DB_HOST=${DB_HOST_PRODUCTION}
DB_PORT=${DB_PORT_PRODUCTION}
DB_USER=${DB_USER_PRODUCTION}
DB_PASSWORD=${DB_PASSWORD_PRODUCTION}
DB_NAME=${DB_NAME_PRODUCTION}

# Para desarrollo local (descomentar):
# DB_HOST=${DB_HOST_LOCAL}
# DB_PORT=${DB_PORT_LOCAL}
# DB_USER=${DB_USER_LOCAL}
# DB_PASSWORD=${DB_PASSWORD_LOCAL}
# DB_NAME=${DB_NAME_LOCAL}

# ============================================================
# SEGURIDAD - JWT
# ============================================================
JWT_SECRET_KEY=tu_clave_secreta_super_segura_cambiar_en_produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ============================================================
# APLICACION
# ============================================================
APP_ENV=development
APP_DEBUG=True
APP_NAME=Sistema Control de Stock
APP_VERSION=3.0.0
APP_TIMEZONE=America/Argentina/Buenos_Aires

# ============================================================
# FRONTEND
# ============================================================
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_PRODUCTION=https://tu-frontend.vercel.app

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.vercel.app

# ============================================================
# EMAIL - SMTP
# ============================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM_EMAIL=tu_email@gmail.com
SMTP_FROM_NAME=Sistema Control de Stock
SMTP_USE_TLS=true

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============================================================
# PAGINACION
# ============================================================
PAGINATION_DEFAULT_PAGE=1
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# ============================================================
# STOCK
# ============================================================
STOCK_MINIMO_DEFAULT=5
STOCK_MAXIMO_DEFAULT=100
STOCK_ALERTA_BAJA=10

# ============================================================
# MONEDA
# ============================================================
MONEDA_DEFAULT=ARS
IVA_DEFAULT=21.00
DECIMALES=2

# ============================================================
# SEGURIDAD
# ============================================================
BCRYPT_ROUNDS=10
PASSWORD_MIN_LENGTH=6
SESSION_TIMEOUT_MINUTES=60

# ============================================================
# UPLOAD
# ============================================================
UPLOAD_MAX_SIZE_MB=5
UPLOAD_PATH=uploads/

# ============================================================
# API
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_MINUTES=1
DOCS_ENABLED=true